{
  "name": "handwritten-notebook",
  "version": "3.16.2",
  "private": true,
  "description": "Obsidian plugin for handwritten notes on A4 pages.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/esbuild.config.mjs --watch",
    "build": "node scripts/esbuild.config.mjs",
    "typecheck": "tsc -p src",
    "lint": "eslint .",
    "site:dev": "node scripts/build-site.mjs --serve",
    "site:build": "node scripts/build-site.mjs",
    "site:typecheck": "tsc -p site",
    "embed": "python src/tools/embed_script.py",
    "deploy": "node scripts/deploy.mjs",
    "deploy:watch": "node scripts/deploy.mjs --watch",
    "deploy:local": "npm run build && npm run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "globals": "^17.14.0",
    "lucide": "^1.68.0",
    "obsidian": "latest",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1"
  }
}
